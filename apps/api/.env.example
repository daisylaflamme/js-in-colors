# Ask Dot API (apps/api). Copy this file to apps/api/.env and fill it in.
# apps/api/.env is git-ignored. Never commit a real key, and never paste it into a chat.

# demo = canned, kid-safe answers (free, the default). groq = live AI (needs GROQ_API_KEY).
CHAT_PROVIDER=demo

# From https://console.groq.com/keys (server-side only; the browser never sees it).
GROQ_API_KEY=
# A small, fast production model (checked 2026-11-05 on console.groq.com/docs/models).
GROQ_MODEL=llama-3.1-8b-instant

# Limits. Keep CHAT_DAILY_CAP below your free requests/day (console.groq.com/settings/limits).
CHAT_PER_MINUTE=5
CHAT_PER_DAY=30
CHAT_DAILY_CAP=500

# The web app's address (CORS) and the API port.
CHAT_ALLOWED_ORIGIN=http://localhost:4200
PORT=3333
